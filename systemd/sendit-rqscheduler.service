[Unit]
Description=RQ Worker Cron Scheduler
After=network.target sendit-per-db.service sendit-mem-db.service

[Service]
Type=simple
WorkingDirectory=/var/www/sendit-worker
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
Environment=LC_LANG=en_US.UTF-8
ExecStart=/var/www/sendit-worker/worker_env/bin/python -u manage.py cronrqscheduler
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID
PrivateTmp=true
Restart=always

[Install]
WantedBy=multi-user.target