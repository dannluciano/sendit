[Unit]
Description=SendIT Ambassador Memory Data Base
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/sendit-worker
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
Environment=LC_LANG=en_US.UTF-8
ExecStart=docker run --rm -ti --link dokku.redis.senditdb -p 6379:6379 dokku/ambassador
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID
PrivateTmp=true
Restart=always

[Install]
WantedBy=multi-user.target